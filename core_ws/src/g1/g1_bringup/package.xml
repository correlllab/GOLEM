<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_bringup</name>
  <version>0.0.0</version>
  <description>Launch files that start the G1 stack (real robot from a laptop, or the sim).</description>
  <maintainer email="maxlconway@gmail.com">max</maintainer>
  <license>MIT</license>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>g1_description</exec_depend>
  <exec_depend>g1_dex3</exec_depend>
  <exec_depend>g1_locomotion</exec_depend>
  <exec_depend>g1_navigation</exec_depend>
  <exec_depend>g1_control</exec_depend>
  <exec_depend>g1_safety_layer</exec_depend>
  <exec_depend>custom_ros_messages</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
