<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_locomotion</name>
  <version>0.0.0</version>
  <description>HOMIE's walking policy on the Unitree G1's legs, through g1_safety_layer's split mode</description>
  <maintainer email="npudasai@nd.edu">Niraj Pudasaini</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>g1_description</depend>
  <exec_depend>g1_safety_layer</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
