  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>estop</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>golem_safety</exec_depend>
  <exec_depend>golem_upper_ik</exec_depend>
  <exec_depend>h12_lowerbody_rl</exec_depend>
  <exec_depend>lmg_deploy</exec_depend>
  <exec_depend>golem_ros2_models</exec_depend>
  <exec_depend>dex_3</exec_depend>
  <exec_depend>g1_homie</exec_depend>
  <exec_depend>g1_navigation</exec_depend>
  <exec_depend>cl_realsense</exec_depend>
