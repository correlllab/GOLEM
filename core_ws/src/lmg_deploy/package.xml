<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lmg_deploy</name>
  <version>0.0.0</version>
  <description>LocoMotionGameDeploy: runs the two-agent (legs + IK arms) MARL policy from
    Locomanipulation_game on the H1-2 through the split safety layer.</description>
  <maintainer email="maxlconway@gmail.com">maxconway</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>custom_ros_messages</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>unitree_hg</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <!-- torch comes from pip in the golem_ros image (no rosdep key) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
