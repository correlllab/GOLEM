# Optional settings shared by Linux and Mac wrappers. Exported shell values win.
#   cp docker/.env.example docker/.env
# Values containing spaces must be quoted. Relative paths are checkout-relative
# when using the wrappers; use absolute paths for direct Compose commands.

ROS_DOMAIN_ID=1
GEMINI_API_KEY=your-gemini-api-key-here

# Optional host mount roots; defaults: CL_Assets and container_cache in this repo.
# GOLEM_ASSETS_DIR=/mnt/robot-assets
# GOLEM_CACHE_DIR=/mnt/robot-cache

# Linux: auto (GUI if DISPLAY is set), gui, headless. Mac: headless or vnc.
# GOLEM_DISPLAY=headless
# MacBook Air first smoke test: disable camera rendering to reduce CPU work.
# GOLEM_CAMERAS=0
# GOLEM_RVIZ=vnc

# Paired startup waits for a DDS sample before bringup (seconds).
# GOLEM_SIM_TIMEOUT=180
# Linux paired startup enables RViz only in GUI mode unless overridden.
# GOLEM_USE_RVIZ=false
