# Settings the host wrappers (docker/scripts/*.sh, docker/mac/scripts/*.sh) and
# Compose read. Copy it to docker/.env, which git ignores:
#   cp docker/.env.example docker/.env
# Values exported in the shell override this file. Quote values that contain
# spaces. The wrappers resolve relative paths against the checkout; direct
# `docker compose` commands need absolute paths.

# DDS domain of every container, 1..232 for a simulator. 0 is the real robots'
# command bus: the wrappers refuse a simulator on it and ask before starting
# the x86 workspace container there.
ROS_DOMAIN_ID=1
# Gemini API key, for model_server's gemini_server and golem_skills.
GEMINI_API_KEY=your-gemini-api-key-here

# The robot the x86 simulator and stack wrappers start: h12 or g1. --g1 / --h12
# on a wrapper overrides it; the Mac wrappers refuse g1.
GOLEM_ROBOT=h12

# Host roots of the asset and cache mounts; defaults: CL_Assets and
# container_cache in this checkout.
# GOLEM_ASSETS_DIR=/mnt/robot-assets
# GOLEM_CACHE_DIR=/mnt/robot-cache

# Display mode. Linux: auto (GUI when DISPLAY is set), gui or headless.
# Mac: headless or vnc (the MuJoCo viewer over noVNC).
# GOLEM_DISPLAY=headless
# 0 drops the simulator's camera rendering, its heaviest CPU cost.
# GOLEM_CAMERAS=0
# Mac: vnc also runs RViz over noVNC.
# GOLEM_RVIZ=vnc

# s the stack wrappers wait for the simulator's first rt/lowstate sample
# before starting the bringup.
# GOLEM_SIM_TIMEOUT=180
# Linux stack: RViz in the bringup, true or false (default: true when DISPLAY
# is set).
# GOLEM_USE_RVIZ=false

# CPU pinning (x86 Linux wrappers and tests). On a hybrid CPU (P-cores and
# E-cores) the RoboCasa sim is pinned to the P-cores and the ros container to
# the E-cores, which runs the sim faster; nothing is pinned otherwise, on
# ROS_DOMAIN_ID=0 (the real robots), or on the Isaac simulator and the Mac.
# 0 turns pinning off, the explicit lists below included.
# GOLEM_CPU_PINNING=0
# Explicit lists, docker's --cpuset-cpus syntax (0-15, 0,2,4-5), instead of the
# detected ones; a CPU that is not online fails the wrapper. An explicit
# GOLEM_ROS_CPUSET on domain 0 is refused.
# GOLEM_SIM_CPUSET=0-15
# GOLEM_ROS_CPUSET=16-27
