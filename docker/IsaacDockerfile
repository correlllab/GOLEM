#dockerfile june 2026, literally almost exactly a combination of isaaclab's dockerfiles, so shoutout them lol

# Build the gripper process against the same ROS distribution as GOLEM.
# Isaac's bundled CPython has a different ABI, so this runtime stays private.
FROM ros:humble-ros-base-jammy@sha256:1813d3c85d7f96ff7d3012d865204583255740182db5d0065f8f8cd029a83138 AS magpie_humble
COPY docker/locks/isaac-*.txt docker/locks/apt-sources.sh docker/locks/ros-snapshot.asc /opt/golem-locks/
RUN sh /opt/golem-locks/apt-sources.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rosidl-default-generators \
    && rm -rf /var/lib/apt/lists/*
COPY core_ws/src/magpie_msgs /tmp/magpie_msgs
RUN . /opt/ros/humble/setup.sh && cd /tmp && \
    colcon build --base-paths /tmp/magpie_msgs --packages-select magpie_msgs \
    --merge-install --install-base /opt/golem-magpie-humble --cmake-args -DBUILD_TESTING=OFF
COPY docker/scripts/package_humble_runtime.py /tmp/package_humble_runtime.py
RUN . /opt/ros/humble/setup.sh && . /opt/golem-magpie-humble/setup.sh && \
    python3 /tmp/package_humble_runtime.py

FROM nvcr.io/nvidia/isaac-sim:5.1.0@sha256:f3563cb2ba0c18af0b2fb321360dcb73a917b899f879e3213623d6bee484fa54 AS builder
COPY docker/locks/isaac-*.txt docker/locks/apt-sources.sh docker/locks/ros-snapshot.asc /opt/golem-locks/

USER root
RUN sh /opt/golem-locks/apt-sources.sh

ENV ACCEPT_EULA=Y
ENV OMNI_KIT_ACCEPT_EULA=yes

ENV ISAACLAB_PATH=/workspace/golem/isaac/IsaacLab
ENV ISAACSIM_ROOT_PATH=/isaac-sim
ENV GOLEM_WORKSPACE_PATH=/workspace/golem/isaac
ENV DOCKER_USER_HOME=/root


RUN --mount=type=cache,target=/var/cache/apt \
  apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  cmake \
  git \
  libglib2.0-0 \
  ncurses-term \
  wget && \
  apt -y autoremove && apt clean autoclean && \
  rm -rf /var/lib/apt/lists/*


WORKDIR ${GOLEM_WORKSPACE_PATH}

RUN git clone https://github.com/isaac-sim/IsaacLab.git && \
  git -C IsaacLab checkout --quiet b4c321024792976150ca55fddb26fa34480d974e

WORKDIR ${ISAACLAB_PATH}
# IsaacLab's extras otherwise resolve moving VCS refs even at a fixed Lab SHA.
# Reuse commits recorded by pip in the validated existing Isaac image.
RUN grep -Fq 'rl_games.git@python3.11' source/isaaclab_rl/setup.py \
  && sed -i 's|rl_games.git@python3.11|rl_games.git@6b3534f29568158e9e29ec8bf83cc88fce5f0cae|' source/isaaclab_rl/setup.py \
  && grep -Fq 'robomimic.git@v0.4.0' source/isaaclab_mimic/setup.py \
  && sed -i 's|robomimic.git@v0.4.0|robomimic.git@7c66e7a41b5d9dcc905b1a68346bfee1b49b79c9|' source/isaaclab_mimic/setup.py
#this verison corresponds to Jun 12

RUN chmod +x ${ISAACLAB_PATH}/isaaclab.sh

RUN ln -sf ${ISAACSIM_ROOT_PATH} ${ISAACLAB_PATH}/_isaac_sim

RUN ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install -c /opt/golem-locks/isaac-amd64-01.txt toml

RUN --mount=type=cache,target=/var/cache/apt \
  ${ISAACLAB_PATH}/isaaclab.sh -p ${ISAACLAB_PATH}/tools/install_deps.py apt ${ISAACLAB_PATH}/source && \
  apt -y autoremove && apt clean autoclean && \
  rm -rf /var/lib//apt/lists/*

RUN mkdir -p ${ISAACSIM_ROOT_PATH}/kit/cache && \
  mkdir -p ${DOCKER_USER_HOME}/.cache/ov && \
  mkdir -p ${DOCKER_USER_HOME}/.cache/pip && \
  mkdir -p ${DOCKER_USER_HOME}/.cache/nvidia/GLCache && \
  mkdir -p ${DOCKER_USER_HOME}/.nv/ComputeCache && \
  mkdir -p ${DOCKER_USER_HOME}/.nvidia-omniverse/logs && \
  mkdir -p ${DOCKER_USER_HOME}/.local/share/ov/data && \
  mkdir -p ${DOCKER_USER_HOME}/Documents

RUN touch /bin/nvidia-smi && \
  touch /bin/nvidia-debugdump && \
  touch /bin/nvidia-persistenced && \
  touch /bin/nvidia-cuda-mps-control && \
  touch /bin/nvidia-cuda-mps-server && \
  touch /etc/localtime && \
  mkdir -p /var/run/nvidia-persistenced && \
  touch /var/run/nvidia-persistenced/socket

RUN --mount=type=cache,target=${DOCKER_USER_HOME}/.cache/pip \
  PIP_CONSTRAINT=/opt/golem-locks/isaac-amd64-02.txt ${ISAACLAB_PATH}/isaaclab.sh --install

RUN ${ISAACLAB_PATH}/isaaclab.sh -p -m pip uninstall -y quadprog msal

WORKDIR ${GOLEM_WORKSPACE_PATH}
RUN git clone https://github.com/eclipse-cyclonedds/cyclonedds && \
  git -C cyclonedds checkout --quiet 5041f3560c088c99e5088b2b8520b69169621196 && \
  cd cyclonedds && mkdir build install && cd build && \
  cmake .. -DCMAKE_INSTALL_PREFIX=../install && \
  cmake --build . --target install

ENV CYCLONEDDS_HOME=${GOLEM_WORKSPACE_PATH}/cyclonedds/install

RUN git clone https://github.com/unitreerobotics/unitree_sdk2_python.git && \
  git -C unitree_sdk2_python checkout --quiet 65691c8a8bc53b98d3976dba4dbf9d5d20b2e7f5 && \
  cd unitree_sdk2_python && ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install -c /opt/golem-locks/isaac-amd64-03.txt -e .

RUN ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install -c /opt/golem-locks/isaac-amd64-04.txt rerun-sdk==0.20.1 \
  logging_mp==0.1.5 \
  onnxruntime==1.22.1 \
  onnx \
  pynput==1.8.1

RUN echo "export ISAACLAB_PATH=${ISAACLAB_PATH}" >> ${HOME}/.bashrc && \
    echo "export CYCLONEDDS_HOME=${GOLEM_WORKSPACE_PATH}/cyclonedds/install" >> ${HOME}/.bashrc && \
    echo "alias isaaclab=${ISAACLAB_PATH}/isaaclab.sh" >> ${HOME}/.bashrc && \
    echo "alias python=${ISAACLAB_PATH}/_isaac_sim/python.sh" >> ${HOME}/.bashrc && \
    echo "alias python3=${ISAACLAB_PATH}/_isaac_sim/python.sh" >> ${HOME}/.bashrc && \
    echo "alias pip='${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip'" >> ${HOME}/.bashrc && \
    echo "alias pip3='${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip'" >> ${HOME}/.bashrc && \
    echo "alias tensorboard='${ISAACLAB_PATH}/_isaac_sim/python.sh ${ISAACLAB_PATH}/_isaac_sim/tensorboard'" >> ${HOME}/.bashrc && \
    echo "export TZ=$(date +%Z)" >> ${HOME}/.bashrc && \
    echo "shopt -s histappend" >> /root/.bashrc && \
    echo "PROMPT_COMMAND='history -a'" >> /root/.bashrc

RUN --mount=type=cache,target=/var/cache/apt \
  apt-get update && apt-get install -y --no-install-recommends curl \
  software-properties-common && \
  add-apt-repository universe && \
  sh /opt/golem-locks/apt-sources.sh && \
  curl -sSL https://raw.githubusercontent.com/ros/rosdistro/e31287f892ecd01b170d1cbfa298db35abe4a74f/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/opt/golem-locks/ros-snapshot.asc] http://snapshots.ros.org/jazzy/2026-09-11/ubuntu noble main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null && \
  apt-get update && apt-get install -y --no-install-recommends \
  ros-jazzy-ros-base \
  ros-jazzy-vision-msgs \
  ros-jazzy-rmw-cyclonedds-cpp \
  ros-dev-tools && \
  ${ISAACLAB_PATH}/isaaclab.sh -p ${ISAACLAB_PATH}/tools/install_deps.py rosdep ${ISAACLAB_PATH}/source && \
  apt -y autoremove && apt clean autoclean && \
  rm -rf /var/lib/apt/lists/* && \
  echo "source /opt/ros/jazzy/setup.bash" >> ${HOME}/.bashrc


WORKDIR ${GOLEM_WORKSPACE_PATH}

ENTRYPOINT []
CMD ["/bin/bash"]


COPY --from=magpie_humble /native-python /opt/golem-humble-python
COPY --from=magpie_humble /opt/ros/humble /opt/ros/humble
COPY --from=magpie_humble /opt/golem-magpie-humble /opt/golem-magpie-humble
RUN PYTHONHOME=/opt/golem-humble-python \
    PYTHONPATH=/opt/golem-humble-python/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages:/opt/ros/humble/lib/python3.10/site-packages:/opt/golem-magpie-humble/local/lib/python3.10/dist-packages:/opt/golem-magpie-humble/lib/python3.10/site-packages \
    LD_LIBRARY_PATH=/opt/golem-humble-python/lib:/opt/ros/humble/lib:/opt/golem-magpie-humble/lib \
    /opt/golem-humble-python/bin/python3.10 -c "from rclpy.action import ActionServer; from magpie_msgs.msg import GripperState; GripperState.__class__.__import_type_support__()"
