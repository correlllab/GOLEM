# golem_sim_robocasa: the MuJoCo / RoboCasa simulator of both robots, on
# golem_base (BaseDockerfile). It holds MuJoCo 3.17.0, robosuite and RoboCasa
# (patched for 3.17.0) with the kitchen assets, the colcon toolchain for the
# message-only msgs_ws, and livox_ros_driver2 for the lidar's CustomMsg. The
# simulator source (golem_robocasa) is bind-mounted at runtime
# (docker-compose.yml); launch_robocasa.sh starts it. docker/BUILD.md §5
# describes the image.
FROM golem_base:latest
COPY docker/locks/robocasa-*.txt docker/locks/robocasa-assets.digest /opt/golem-locks/

# Optional build-time proxies (golem_base clears its own).
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

# Offscreen GPU rendering for the RGBD cameras and the MID-360's rays, in the
# sims and in shells; the sims stop at start without a GPU to render on.
# launch_robocasa.sh exports MUJOCO_GL=egl as well, in both display modes; the
# passive viewer opens its own GLFW window.
ENV MUJOCO_GL=egl

# MuJoCo's runtime rendering libraries: EGL and OSMesa for headless rendering.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libegl1-mesa libosmesa6 \
    && rm -rf /var/lib/apt/lists/*

# The MuJoCo Python bindings and Pillow (image encoding). mujoco is 3.3.1
# here because RoboCasa's setup.py pins exactly that version and would replace
# any other while installing; the last step replaces it with 3.17.0.
RUN uv pip install -c /opt/golem-locks/robocasa-amd64-01.txt --system --no-cache \
        "mujoco==3.3.1" \
        "numpy>=2.2.6" \
        "Pillow>=10.0"

# robosuite and RoboCasa, at fixed commits: every h12_mujoco.py task is a
# RoboCasa kitchen, whose KitchenArena subclasses robosuite's Arena. Neither is
# fully on PyPI, so both install from git, editable. RoboCasa depends on
# lerobot, which pins torch 2.7.1 and so replaces base's cu130 torch in this
# image only.
RUN git clone https://github.com/ARISE-Initiative/robosuite /opt/robosuite && \
    git -C /opt/robosuite checkout --quiet 5ce6643f3092639d08f7b0f90ed1c6a84f50552c && \
    uv pip install -c /opt/golem-locks/robocasa-amd64-02.txt --system --no-cache -e /opt/robosuite

RUN git clone https://github.com/robocasa/robocasa /opt/robocasa && \
    git -C /opt/robocasa checkout --quiet 4f8a2980def75a55dff96b990745b83540425f09 && \
    uv pip install -c /opt/golem-locks/robocasa-amd64-03.txt --system --no-cache -e /opt/robocasa

# Write robosuite's and RoboCasa's private macro files now; without them both
# warn on every import.
RUN python /opt/robosuite/robosuite/scripts/setup_macros.py && \
    python /opt/robocasa/robocasa/scripts/setup_macros.py

# Optional robosuite / RoboCasa dependencies, installed only so their imports
# stop printing "not installed" warnings; nothing here uses them.
# robosuite_models (extra robot meshes) and mimicgen are git-only, at fixed
# commits; mink is 0.0.5, the version robosuite's warning asks for.
RUN git clone https://github.com/ARISE-Initiative/robosuite_models /opt/robosuite_models && \
    git -C /opt/robosuite_models checkout --quiet 2d63a6b4319bda772420daf10594ce0de5bd793d && \
    uv pip install -c /opt/golem-locks/robocasa-amd64-04.txt --system --no-cache -e /opt/robosuite_models && \
    git clone https://github.com/NVlabs/mimicgen /opt/mimicgen && \
    git -C /opt/mimicgen checkout --quiet 72bd767c255545f462e7ccfb2731f2e5d4c1d9bb && \
    uv pip install -c /opt/golem-locks/robocasa-amd64-04.txt --system --no-cache -e /opt/mimicgen && \
    uv pip install -c /opt/golem-locks/robocasa-amd64-04.txt --system --no-cache --no-deps "mink==0.0.5"

# RoboCasa's textures, fixtures and objects (about 10 GB): KitchenArena fails
# without them, so they are baked in and the container is ready to run. The
# download script has no --yes flag, so `echo y` answers its confirmation
# prompt; it asks nothing per folder because every asset registry entry sets
# check_folder_exists=False.
RUN echo y | python -m robocasa.scripts.download_kitchen_assets --type all
# Check the downloaded tree against the committed digest of every file's
# sha256 (locks/SOURCES.md), so a changed, added or missing asset fails the
# build.
RUN cd /opt/robocasa/robocasa/models && \
    find assets -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | \
    sha256sum --check /opt/golem-locks/robocasa-assets.digest

WORKDIR /home/code/golem_robocasa

# A shell; docker-compose.yml's command runs launch_robocasa.sh instead.
CMD ["/bin/bash"]

# -----------------------------------------------------------------------------
# The msgs_ws toolchain: colcon, ament and rosidl, so launch_robocasa.sh can
# build the message-only workspace (magpie_msgs, custom_ros_messages) at every
# container start.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions \
        ros-humble-ament-cmake \
        ros-humble-ament-cmake-auto \
        ros-humble-ament-cmake-python \
        ros-humble-rosidl-default-generators \
    && rm -rf /var/lib/apt/lists/*

# The mount point of core_ws/src/{magpie_msgs,custom_ros_messages}.
RUN mkdir -p /home/code/msgs_ws/src

# -----------------------------------------------------------------------------
# Livox-SDK2, which livox_ros_driver2 links (its messages build in the same
# package), at the commit every image uses (tests/docker/test_source_pins.py),
# so the images agree on the CustomMsg wire format. The recipe is
# RosDockerfile's.
# -----------------------------------------------------------------------------
RUN git clone https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 && \
    git -C /tmp/Livox-SDK2 checkout --quiet 08f523c930b2f0ba1e98a6afaa8d7476bf479908 && \
    cd /tmp/Livox-SDK2 && mkdir build && cd build && \
    cmake .. -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && make -j"$(nproc)" && make install && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

# -----------------------------------------------------------------------------
# livox_ros_driver2's C++ build dependencies (its package_ROS2.xml).
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpcl-dev libapr1-dev \
        ros-humble-pcl-conversions ros-humble-pcl-ros \
        ros-humble-rclcpp-components ros-humble-rcl-interfaces \
        ros-humble-rosbag2 \
        ros-humble-sensor-msgs ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# livox_ros_driver2 at /opt/livox_ws, so the sensor suites (h12_sensors.py,
# g1/g1_sensors.py) can publish its CustomMsg on /livox/lidar. It is copied
# rather than bind-mounted: upstream's build.sh rewrites its own source tree
# (package_ROS2.xml -> package.xml, launch_ROS2/ -> launch/), which would
# collide with the ros container's mount of core_ws/src. build.sh deletes
# ../../build and ../../install first, so /opt/livox_ws/src holds only this
# package. build.sh exits 0 even when its colcon build fails (CLAUDE.md §8).
# build/ is left in place: it is small, and a --symlink-install build's
# install/ points into it.
# -----------------------------------------------------------------------------
COPY core_ws/src/livox_ros_driver2 /opt/livox_ws/src/livox_ros_driver2
RUN bash -c "source /opt/ros/humble/setup.bash && \
             cd /opt/livox_ws/src/livox_ros_driver2 && \
             ./build.sh humble"

# -----------------------------------------------------------------------------
# MuJoCo 3.17.0 over the 3.3.1 that RoboCasa installs above, and the patches
# robosuite and RoboCasa need for it (docker/patches/, each file says why).
# 3.17.0 is the newest MuJoCo with a wheel for this image's Python 3.10 (4.0
# drops 3.10), and it steps both robots' kitchens about 40% faster than 3.3.1
# (docs/superpowers/specs/2026-11-05-sim-speed-results.md); golem_robocasa
# calls its API directly. The ros image keeps 3.2.3 for MJPC's ABI. The step
# comes after robosuite's and RoboCasa's installs, which would put 3.3.1 back.
# `git apply` fails the build when a patch no longer applies at the pinned
# commits, and the import checks that robosuite and RoboCasa load on 3.17.0.
# -----------------------------------------------------------------------------
COPY docker/patches/robosuite-mujoco-3.17.0.patch docker/patches/robocasa-mujoco-3.17.0.patch /opt/golem-patches/
RUN uv pip install -c /opt/golem-locks/robocasa-amd64-05.txt --system --no-cache "mujoco==3.17.0" && \
    git -C /opt/robosuite apply /opt/golem-patches/robosuite-mujoco-3.17.0.patch && \
    git -C /opt/robocasa apply /opt/golem-patches/robocasa-mujoco-3.17.0.patch && \
    cd / && python -c "import mujoco, robosuite, robocasa; assert mujoco.__version__ == '3.17.0', mujoco.__version__"
