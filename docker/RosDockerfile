# golem_ros: the ROS 2 workspace image, on golem_base (BaseDockerfile).
#
# It bakes the toolchain and the Python dependencies of core_ws, not core_ws
# itself: launch_ros.sh colcon-builds the bind-mounted core_ws at every
# container start. On top of base it adds colcon and the ament / rosidl build
# system, the C++ libraries the workspace links (PCL, Eigen, yaml-cpp, OpenCV,
# pinocchio), Livox-SDK2, the Pink IK / OMPL stack, the model_server ML stack
# (transformers, CLIP, SAM3, YOLO, Gemini), Nav2 and SLAM, GraspGenX, the
# RealSense driver, OctoMap and the G1's dependencies.
#
# Layers run from most to least stable, and blocks added later go at the end,
# so editing a late block does not rebuild the heavy layers above it. Every pip
# step installs through a numbered lock step (-c with locks/ros-amd64-NN.txt,
# enforced by tests/docker/test_source_pins.py). docker/BUILD.md §4 has the
# layer map.
FROM golem_base:latest
COPY docker/locks/ros-*.txt /opt/golem-locks/

# Optional build-time proxies (golem_base clears its own).
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

# -----------------------------------------------------------------------------
# 1. apt: build tooling, system Python C-extensions and the ROS packages core_ws
#    builds against.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        # build tooling
        pkg-config \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        # Python packages with C extensions, built against the system ABIs
        python3-numpy python3-scipy python3-yaml python3-transforms3d \
        # C++ libraries core_ws links (yaml-cpp: golem_safety's configs)
        libpcl-dev libeigen3-dev libyaml-cpp-dev libopencv-dev \
        # ament / rosidl build system
        ros-humble-ament-cmake \
        ros-humble-ament-cmake-auto \
        ros-humble-ament-cmake-python \
        ros-humble-ament-lint-auto \
        ros-humble-rosidl-default-generators \
        # unitree_api / unitree_go / unitree_hg find_package() it REQUIRED;
        # neither ros-base nor rosidl-default-generators pulls it in on Humble
        ros-humble-rosidl-generator-dds-idl \
        # message types the workspace uses
        ros-humble-image-transport \
        ros-humble-vision-msgs \
        ros-humble-nav-msgs \
        ros-humble-std-msgs \
        ros-humble-std-srvs \
        ros-humble-visualization-msgs \
        # robot description and launch
        ros-humble-xacro \
        ros-humble-robot-state-publisher \
        ros-humble-joint-state-publisher \
        ros-humble-launch-ros \
        ros-humble-launch-xml \
        # PCL and TF integration
        ros-humble-pcl-ros \
        ros-humble-pcl-conversions \
        ros-humble-tf2-eigen \
        ros-humble-tf2-tools \
        # rclcpp and RViz
        ros-humble-rclcpp \
        ros-humble-rclcpp-components \
        ros-humble-rviz2 \
        # the pinocchio that golem_upper_ik and lmg_deploy exec_depend on; with
        # ROS sourced, `import pinocchio` resolves to this build, ahead of the
        # pip `pin` of step 3 on PYTHONPATH
        ros-humble-pinocchio \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. Livox-SDK2, which livox_ros_driver2 in core_ws links. Built at the commit
#    every image uses (tests/docker/test_source_pins.py), so all images agree on
#    the CustomMsg wire format. CMAKE_POLICY_VERSION_MINIMUM lets current CMake
#    accept upstream's old cmake_minimum_required.
# -----------------------------------------------------------------------------
RUN git clone https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 && \
    git -C /tmp/Livox-SDK2 checkout --quiet 08f523c930b2f0ba1e98a6afaa8d7476bf479908 && \
    cd /tmp/Livox-SDK2 && mkdir build && cd build && \
    cmake .. -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && make -j"$(nproc)" && make install && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

# -----------------------------------------------------------------------------
# 3. Python: golem_upper_ik's controller stack (Pink differential IK, the QP
#    backends, OMPL planning, meshcat) and open3d.
# -----------------------------------------------------------------------------
# Remove base's NumPy-2 kinematics closure (pinocchio and its cmeel C++
# libraries) first: the next step runs with --ignore-installed, which writes
# over packages without uninstalling them and would leave two cmeel-boost
# versions side by side.
RUN pip uninstall -y pin libpinocchio coal libcoal eigenpy \
        cmeel cmeel-assimp cmeel-boost cmeel-console-bridge cmeel-octomap \
        cmeel-qhull cmeel-tinyxml2 cmeel-urdfdom cmeel-zlib
# numpy<2 binds the C extensions installed here to the NumPy 1.x ABI of apt's
# scipy and pinocchio. --ignore-installed applies to the whole call; it lets pip
# replace apt's python3-blinker, which pip cannot uninstall.
RUN pip install -c /opt/golem-locks/ros-amd64-01.txt --no-cache-dir --ignore-installed blinker \
        "numpy<2" \
        "scikit-learn>=1.4" \
        pin-pink \
        qpsolvers \
        quadprog \
        proxsuite \
        "ompl==2.0.1" \
        meshcat \
        meshcat-shapes \
        pyquaternion \
        tqdm \
        open3d

# -----------------------------------------------------------------------------
# 4. Python: the model_server ML stack, exact-pinned. Model weights are not in
#    the image: they live under core_ws/src/model_server/weights and arrive
#    with the core_ws bind mount.
# -----------------------------------------------------------------------------
RUN pip install -c /opt/golem-locks/ros-amd64-02.txt --no-cache-dir \
        "transformers==4.47.1" \
        "google-genai==1.30.0" \
        "matplotlib==3.9.3" \
        "Pillow==11.0.0" \
        "timm==1.0.17" \
        "ftfy==6.1.1" \
        "regex==2024.11.6" \
        "huggingface_hub==0.27.0" \
        "einops==0.8.0" \
        "pycocotools==2.0.8" \
        "ultralytics==8.3.52"

RUN pip install -c /opt/golem-locks/ros-amd64-03.txt --no-cache-dir \
        "opencv-python-headless==4.10.0.84" \
        "iopath==0.1.10"

# CLIP is not on PyPI: install it from a fixed commit, without its dependencies
# (torch, ftfy, regex and tqdm are already installed).
RUN git clone https://github.com/openai/CLIP.git /opt/clip \
    && cd /opt/clip && git checkout a1d071733d7111c9c014f024669f959182114e33
RUN pip install -c /opt/golem-locks/ros-amd64-04.txt --no-cache-dir --no-deps /opt/clip

# -----------------------------------------------------------------------------
# 5. SAM3, at a fixed commit. Its setup.py builds a package named UNKNOWN-0.0.0,
#    so it is put on PYTHONPATH instead of being pip-installed. hydra-core
#    resolves its model configs.
# -----------------------------------------------------------------------------
RUN pip install -c /opt/golem-locks/ros-amd64-05.txt --no-cache-dir "hydra-core>=1.3.2"

RUN git clone https://github.com/facebookresearch/sam3.git /opt/sam3 && \
    git -C /opt/sam3 checkout --quiet 660a5e9e1b8b4c02c0ad97229b88a09a6e4ff5b7
ENV PYTHONPATH=/opt/sam3:${PYTHONPATH}

# -----------------------------------------------------------------------------
# 6. Clamp numpy, setuptools and wheel back to what colcon and the ABI need,
#    after the pip steps above moved them:
#      numpy<2             apt scipy 1.8 and pinocchio are built for NumPy 1.x.
#      setuptools==59.6.0  colcon's python_setup_py literal_evals setup()
#                          arguments, and setuptools 69+ returns a SpecifierSet
#                          object there, so ament_python builds fail.
#      wheel<0.44          0.44's bdist_wheel entry point imports
#                          setuptools.command.bdist_wheel, which setuptools 59.6
#                          lacks.
#    The rm -rf comes first: layered uv and pip upgrades leave several
#    setuptools / wheel .dist-info directories, importlib.metadata reads all of
#    them, and a newer pkg_resources imports jaraco.text, which --no-deps does
#    not install. --no-deps keeps the resolver from replacing these pins.
# -----------------------------------------------------------------------------
RUN rm -rf /usr/local/lib/python3.10/dist-packages/setuptools \
           /usr/local/lib/python3.10/dist-packages/setuptools-*.dist-info \
           /usr/local/lib/python3.10/dist-packages/pkg_resources \
           /usr/local/lib/python3.10/dist-packages/pkg_resources-*.dist-info \
           /usr/local/lib/python3.10/dist-packages/_distutils_hack \
           /usr/local/lib/python3.10/dist-packages/wheel \
           /usr/local/lib/python3.10/dist-packages/wheel-*.dist-info \
    && pip install -c /opt/golem-locks/ros-amd64-06.txt --no-cache-dir --no-deps "numpy<2" "setuptools==59.6.0" "wheel<0.44"

# -----------------------------------------------------------------------------
# 7. Interactive shells source the core_ws overlay once launch_ros.sh has built
#    it (base's .bashrc already sources /opt/ros/humble).
# -----------------------------------------------------------------------------
RUN echo '[ -f /home/code/core_ws/install/setup.bash ] && source /home/code/core_ws/install/setup.bash' >> /root/.bashrc

# -----------------------------------------------------------------------------
# 8. Delete distutils-precedence.pth. Step 6 removed _distutils_hack/, but pip
#    found apt's setuptools 59.6.0 already satisfying the pin, so the .pth of
#    the newer setuptools stayed and every Python start printed
#    "ModuleNotFoundError: No module named '_distutils_hack'". setuptools 59.6
#    does not need it.
# -----------------------------------------------------------------------------
RUN rm -f /usr/local/lib/python3.10/dist-packages/distutils-precedence.pth

WORKDIR /home/code/core_ws

# Build core_ws, then a shell (launch_ros.sh); bringup is a manual step.
CMD ["/home/code/h12_sim_scripts/launch_ros.sh"]

# -----------------------------------------------------------------------------
# Tkinter, for golem_bringup's slider_debugger.py (a Tk GUI for live wrist and
# gripper control).
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-tk \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Navigation, SLAM and debugging tools. golem_slam's navigation.launch.py runs
# Nav2 (ros-humble-navigation2 is the metapackage: BT navigator, planners,
# controllers, costmaps, lifecycle manager), slam_toolbox and
# pointcloud_to_laserscan.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        # Nav2
        ros-humble-navigation2 \
        ros-humble-nav2-bringup \
        # SLAM
        ros-humble-slam-toolbox \
        # lidar cloud -> 2D scan for slam_toolbox and the costmaps
        ros-humble-pointcloud-to-laserscan \
        # rqt GUIs: graph, TF tree, dynamic reconfigure, common plugins
        ros-humble-rqt \
        ros-humble-rqt-common-plugins \
        ros-humble-rqt-graph \
        ros-humble-rqt-tf-tree \
        ros-humble-rqt-reconfigure \
        # drive /cmd_vel by hand (the leg controllers and Nav2 follow it)
        ros-humble-teleop-twist-keyboard \
        ros-humble-teleop-twist-joy \
        # bag recording and replay (golem_slam's record_slam_bag)
        ros-humble-rosbag2 \
        ros-humble-rosbag2-storage-default-plugins \
        # diagnostics and the Foxglove web bridge
        ros-humble-diagnostic-updater \
        ros-humble-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# GraspGenX (NVlabs), for model_server's graspgen_server, installed into the
# system Python. The package goes in with --no-deps; its dependencies then
# install under a constraint file frozen from the whole environment, so they can
# only add packages and never move an installed one (torch, torchvision, timm,
# transformers, numpy, Pillow, setuptools, ...). The two exceptions,
# huggingface-hub for diffusers and psutil for viser, are explained at their
# steps. Not installed, because grasp inference does not need them: pyrender /
# PyOpenGL, scene-synthesizer and urdfpy (GraspGenX uses yourdfpy).
# -----------------------------------------------------------------------------
# GraspGenX looks for its gripper descriptions and checkpoints at these paths
# and clones them when they are unset or missing. Both exist (empty, below), so
# nothing is cloned at runtime; docker-compose.yml points
# GRASPGENX_CHECKPOINT_DIR at model_server's weights and sets
# GRASPGENX_ASSETS_DIR for the Magpie gripper.
ENV GRASPGENX_CHECKPOINT_DIR=/opt/graspgenx/ext/graspgenx_checkpoints \
    GRASPGENX_GRIPPER_CFG_DIR=/opt/graspgenx/ext/gripper_descriptions

# Clone GraspGenX at a fixed commit and install it without its dependencies.
# It declares PEP 621 metadata, which the system setuptools 59.6 (step 6)
# predates, and pip 22.0.2's build isolation would still pick 59.6 and build a
# bogus UNKNOWN-0.0.0 wheel. So the wheel is built against a newer setuptools
# staged in /tmp/bsetup (PYTHONPATH + --no-build-isolation) and the system pip
# installs that wheel; the system setuptools 59.6 is never touched. The source
# stays at /opt/graspgenx.
RUN git clone https://github.com/NVlabs/GraspGenX.git /opt/graspgenx && \
    git -C /opt/graspgenx checkout --quiet b9429097728cb1c430dd78b92edf17ba318aad03 \
    && pip install -c /opt/golem-locks/ros-amd64-07.txt --no-cache-dir --target=/tmp/bsetup "setuptools>=64,<78" wheel setuptools-scm \
    && SETUPTOOLS_SCM_PRETEND_VERSION=1.0.0 PYTHONPATH=/tmp/bsetup \
         pip wheel --no-deps --no-build-isolation -w /tmp/gwheel /opt/graspgenx \
    && pip install -c /opt/golem-locks/ros-amd64-07.txt --no-cache-dir --no-deps /tmp/gwheel/graspgenx-*.whl \
    && rm -rf /tmp/bsetup /tmp/gwheel

# Delete orphaned .dist-info directories (a stray file, no METADATA) before the
# environment is frozen below. pip reports such a directory's version from its
# name, so `pip freeze` would emit a version that is not installed, and pip
# crashes with "OSError: ... /METADATA" when it touches the package. Pillow is
# the usual case: base's uv install writes a REQUESTED file for it, step 3's
# --ignore-installed rewrites its RECORD without REQUESTED, and step 4's
# Pillow pin then uninstalls every file the RECORD lists, leaving REQUESTED
# behind. The sweep matches any name, and the assert checks that the installed
# Pillow's metadata matches the imported module.
RUN for d in /usr/local/lib/python3.10/dist-packages/*.dist-info; do \
        [ -d "$d" ] || continue; \
        if [ ! -e "$d/METADATA" ]; then echo "removing orphaned dist-info: $d"; rm -rf "$d"; fi; \
    done \
    && python3 -c "import PIL, importlib.metadata as m; r=m.version('pillow'); assert r == PIL.__version__, f'pillow metadata {r} != runtime {PIL.__version__}'; print('pillow ok:', r)"

# Freeze the whole environment as the additive-install constraint. grep '=='
# drops the editable, file-URL and comment lines pip freeze also prints.
RUN pip freeze 2>/dev/null | grep '==' > /opt/graspgenx-constraints.txt

# GraspGenX's dependencies that install under the full freeze without moving
# any installed package.
RUN PIP_CONSTRAINT=/opt/graspgenx-constraints.txt pip install -c /opt/golem-locks/ros-amd64-08.txt --no-cache-dir \
        "trimesh==4.5.3" \
        "yourdfpy==0.0.56" \
        torch-geometric \
        tensordict \
        webdataset \
        sharedarray \
        python-fcl \
        addict \
        "yapf==0.40.1" \
        tensorboardx \
        h5py \
        imageio

# diffusers 0.11.1, for GraspGenX's diffusion model. It imports
# huggingface_hub's cached_download, removed in 0.26, so huggingface-hub moves
# from 0.27.0 to 0.25.2, the version that transformers 4.47.1 also accepts. The
# constraint is the freeze without huggingface-hub, so nothing else moves.
RUN grep -viE '^huggingface[-_]hub==' /opt/graspgenx-constraints.txt \
        > /opt/graspgenx-constraints-nohf.txt \
    && PIP_CONSTRAINT=/opt/graspgenx-constraints-nohf.txt pip install -c /opt/golem-locks/ros-amd64-09.txt --no-cache-dir \
        "huggingface-hub==0.25.2" \
        "diffusers==0.11.1"

# viser, the web 3D view of graspgen_server's grasps (http://localhost:8080).
# 0.2.23 is the newest viser that accepts the frozen rich 15.0.0 (every 0.3+
# needs rich<15) and has the server.scene API (add_point_cloud,
# add_line_segments, add_mesh_simple) GraspGenX's viser_utils calls; unpinned,
# pip 22.0.2 backtracks to 0.0.11, which has no .scene. It needs psutil>=5.9.5,
# so it installs under the freeze without psutil and moves psutil to 5.9.8.
RUN grep -viE '^psutil==' /opt/graspgenx-constraints.txt \
        > /opt/graspgenx-constraints-viser.txt \
    && PIP_CONSTRAINT=/opt/graspgenx-constraints-viser.txt pip install -c /opt/golem-locks/ros-amd64-10.txt --no-cache-dir \
        "viser==0.2.23" "psutil==5.9.8"

# The (empty) directories GRASPGENX_*_DIR name. The checkpoints come from
# model_server's weights (docker-compose.yml); the gripper descriptions are not
# baked in (their upstream LFS store is over its quota).
RUN mkdir -p "$GRASPGENX_CHECKPOINT_DIR" "$GRASPGENX_GRIPPER_CFG_DIR"

# -----------------------------------------------------------------------------
# The Intel RealSense ROS driver: h12_real_desktop.launch.py includes
# cl_realsense's h12_hand_cameras.launch.py, which runs realsense2_camera_node
# for the wrist cameras. image-transport-plugins supplies the compressed
# transports; with no plugin the node's image publishers fail with "No plugins
# found!".
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-realsense2-camera \
        ros-humble-image-transport-plugins \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# OctoMap for golem_slam's navigation.launch.py: octomap_server builds the 3D
# map and the /projected_map the Nav2 costmaps load; the RViz plugins display
# OccupancyGrid and OcTree.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-octomap-server \
        ros-humble-octomap-rviz-plugins \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# The G1's additions. joint_state_publisher_gui: golem_ros2_models'
# display.launch.py. onnxruntime 1.23.2: golem_lowerbody_rl runs HOMIE's
# walking policy with it.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-joint-state-publisher-gui \
    && rm -rf /var/lib/apt/lists/*
RUN pip install -c /opt/golem-locks/ros-amd64-11.txt --no-cache-dir onnxruntime==1.23.2 \
    && python3 -c "import onnxruntime"

# -----------------------------------------------------------------------------
# Clamp setuptools, wheel and numpy again, for the reasons of step 6: the
# GraspGenX dependency step (ros-amd64-08) installs setuptools 84 and its
# distutils-precedence.pth, which break colcon's ament_python builds. Last, so
# it also covers every step above. It installs only the three pinned names
# (--no-deps), so step 6's lock, which pins them at these versions, serves.
# -----------------------------------------------------------------------------
RUN rm -rf /usr/local/lib/python3.10/dist-packages/setuptools \
           /usr/local/lib/python3.10/dist-packages/setuptools-*.dist-info \
           /usr/local/lib/python3.10/dist-packages/pkg_resources \
           /usr/local/lib/python3.10/dist-packages/pkg_resources-*.dist-info \
           /usr/local/lib/python3.10/dist-packages/_distutils_hack \
           /usr/local/lib/python3.10/dist-packages/wheel \
           /usr/local/lib/python3.10/dist-packages/wheel-*.dist-info \
    && pip install -c /opt/golem-locks/ros-amd64-06.txt --no-cache-dir --no-deps "numpy<2" "setuptools==59.6.0" "wheel<0.44" \
    && rm -f /usr/local/lib/python3.10/dist-packages/distutils-precedence.pth \
    && python3 -c "import setuptools, wheel, numpy; assert setuptools.__version__ == '59.6.0', setuptools.__version__; assert numpy.__version__.startswith('1.'), numpy.__version__; print('clamp ok:', setuptools.__version__, wheel.__version__, numpy.__version__)"
