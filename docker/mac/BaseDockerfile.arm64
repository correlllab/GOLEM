# golem_base:arm64: the Apple-Silicon (arm64, CPU-only) counterpart of
# docker/BaseDockerfile, the base of the Mac's golem_ros and
# golem_sim_robocasa images, run under Colima with no NVIDIA GPU. It differs
# from the x86 base in two places: it starts from plain Ubuntu 22.04 instead of
# the CUDA image, and it installs PyTorch's CPU wheels instead of cu130. The
# rest (Python 3.10, ROS 2 Humble, CycloneDDS 0.10.x from source, uv, the
# Unitree Python SDK, pin / pink / mink) follows BaseDockerfile, whose comments
# give the reasons. docker_build_mac.sh builds it.

# ubuntu:22.04 has no CA bundle, and apt-sources.sh selects HTTPS snapshots.
# Take the bundle from a digest-pinned Jammy image so TLS stays verified.
FROM ros:humble-ros-base-jammy@sha256:1813d3c85d7f96ff7d3012d865204583255740182db5d0065f8f8cd029a83138 AS ca_bundle
# Ubuntu 22.04 (Jammy), pinned by its multi-arch index digest.
FROM ubuntu:22.04@sha256:829f6df217bcbae2b371026e81711d1a787c61b2967ad09d015063663ebafbf7
COPY --from=ca_bundle /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# The Python constraint files and the dated apt snapshot sources.
COPY docker/locks/base-*.txt docker/locks/apt-sources.sh docker/locks/ros-snapshot.asc /opt/golem-locks/
RUN sh /opt/golem-locks/apt-sources.sh

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Denver
ENV LANG=C.UTF-8
ENV ROS_DISTRO=humble
# The Mac's compose file switches ROS to FastDDS (rmw_fastrtps_cpp); see
# docker/mac/docker-compose.yml.
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Optional build-time proxies; cleared at the end of this file.
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

# Compilers (gcc-12 / g++-12 as default), cmake, git, Python 3.10 as `python`,
# the locale, and Mesa's software GL / EGL / OSMesa for CPU rendering.
# add-apt-repository rewrites sources.list, so apt-sources.sh runs again to put
# the dated snapshots back.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg locales software-properties-common \
        gcc-12 g++-12 cmake build-essential git git-lfs wget unzip \
        python3 python3-dev python3-pip python-is-python3 \
        libglu1-mesa-dev vulkan-tools libvulkan1 \
        libx11-6 libxext6 libxrender1 libxi6 libxrandr2 libxcursor1 libxinerama1 \
        libgl1-mesa-glx libglib2.0-0 libsm6 libxt6 libxkbcommon-x11-0 \
        libegl1-mesa-dev libosmesa6-dev \
    && locale-gen en_US en_US.UTF-8 && update-locale LC_ALL=C.UTF-8 LANG=C.UTF-8 \
    && add-apt-repository universe \
    && sh /opt/golem-locks/apt-sources.sh \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
    && rm -rf /var/lib/apt/lists/*

# The ROS 2 Humble apt source for this architecture (dpkg reports arm64): the
# 2026-08-07 snapshot, verified with the vendored snapshot key. The rosdistro
# key downloaded here is not referenced by any apt source. TODO(max): drop the
# download with the next deliberate Mac base rebuild.
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/e31287f892ecd01b170d1cbfa298db35abe4a74f/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/opt/golem-locks/ros-snapshot.asc] http://snapshots.ros.org/humble/2026-08-07/ubuntu jammy main" \
        > /etc/apt/sources.list.d/ros2.list

# ROS 2 Humble for the simulator's ROS side: ros-base, the CycloneDDS RMW and
# the message / TF / cv_bridge packages its sensor publishers use.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-ros-base \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-sensor-msgs-py \
        ros-humble-tf2-ros \
        ros-humble-tf2-ros-py \
        ros-humble-geometry-msgs \
        ros-humble-rosgraph-msgs \
        ros-humble-cv-bridge \
    && rm -rf /var/lib/apt/lists/*

# uv 0.12.15; the installer URL names the version.
RUN curl -LsSf https://astral.sh/uv/0.12.15/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version

# CycloneDDS 0.10.x from source at golem_base's commit: the PyPI `cyclonedds`
# binding unitree_sdk2_python needs includes dds/ddsi/q_radmin.h, which
# CycloneDDS removed after 0.10.
RUN git clone https://github.com/eclipse-cyclonedds/cyclonedds /cyclonedds && \
    git -C /cyclonedds checkout --quiet 5041f3560c088c99e5088b2b8520b69169621196 && \
    cd /cyclonedds && mkdir build install && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=../install && \
    cmake --build . --target install && \
    rm -rf /cyclonedds/build

ENV CYCLONEDDS_HOME=/cyclonedds/install

# The Unitree Python SDK from the repo's submodule. find_packages skips
# utils/lib (the native CRC libraries, crc_aarch64.so here), so the whole
# package tree is copied over the installed one.
COPY unitree_sdk2_python /home/code/unitree_sdk2_python
RUN cd /home/code/unitree_sdk2_python && \
    uv pip install -c /opt/golem-locks/base-arm64-01.txt --system . && \
    SP=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
    cp -r /home/code/unitree_sdk2_python/unitree_sdk2py/* "$SP/unitree_sdk2py/"

# PyTorch and torchvision, CPU builds. PyPI's default aarch64 torch wheel pulls
# about 3 GB of CUDA libraries that cannot run here, so the CPU index is named
# explicitly. UV_HTTP_TIMEOUT is 600 s for the large wheels.
RUN UV_HTTP_TIMEOUT=600 uv pip install -c /opt/golem-locks/base-arm64-02.txt --system --no-cache \
        torch torchvision \
        --index-url https://download.pytorch.org/whl/cpu

# Kinematics libraries: `pin` (the pinocchio module), pink and mink. The Mac's
# golem_ros replaces this pinocchio with its own NumPy-1.26 build.
RUN uv pip install -c /opt/golem-locks/base-arm64-03.txt --system --no-cache pin pink mink

RUN echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc

# Clear the build-time proxies.
ENV http_proxy=
ENV https_proxy=

WORKDIR /home/code
