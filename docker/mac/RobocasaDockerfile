# golem_sim_robocasa:arm64: the Mac (Apple Silicon) twin of
# docker/RobocasaDockerfile, the MuJoCo / RoboCasa simulator of both robots, on
# golem_base:arm64 (mac/BaseDockerfile). Same stages, commits, patches and
# kitchen-asset digest as the x86 image, with the arm64 locks and OSMesa as the
# renderer: the Mac has no NVIDIA GPU, so the sims run with GOLEM_RENDER=cpu,
# which draws the cameras in software and has no MID-360 (docs/MAC.md). The
# simulator source (golem_robocasa) is bind-mounted at runtime.
FROM golem_base:arm64
COPY docker/locks/robocasa-arm64*.txt docker/locks/robocasa-assets.digest /opt/golem-locks/

# Optional build-time proxies (golem_base clears its own).
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

# Software rendering for the RGBD cameras in the sims and in shells.
# launch_robocasa.sh sets MUJOCO_GL from GOLEM_RENDER as well
# (docker-compose.mac.yml sets cpu).
ENV MUJOCO_GL=osmesa

# MuJoCo's runtime rendering libraries: EGL and OSMesa for headless rendering.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libegl1-mesa libosmesa6 \
    && rm -rf /var/lib/apt/lists/*

# The MuJoCo Python bindings and Pillow; 3.3.1 first because RoboCasa's
# setup.py pins it, and the last step replaces it with 3.17.0 (as on x86).
RUN uv pip install -c /opt/golem-locks/robocasa-arm64-01.txt --system --no-cache \
        "mujoco==3.3.1" \
        "numpy>=2.2.6" \
        "Pillow>=10.0"

# robosuite and RoboCasa at the x86 image's commits, editable. RoboCasa's
# lerobot pins torch 2.7.1, which replaces base's CPU torch in this image.
RUN git clone https://github.com/ARISE-Initiative/robosuite /opt/robosuite && \
    git -C /opt/robosuite checkout --quiet 5ce6643f3092639d08f7b0f90ed1c6a84f50552c && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-02.txt --system --no-cache -e /opt/robosuite

RUN git clone https://github.com/robocasa/robocasa /opt/robocasa && \
    git -C /opt/robocasa checkout --quiet 4f8a2980def75a55dff96b990745b83540425f09 && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-03.txt --system --no-cache -e /opt/robocasa

# robosuite's and RoboCasa's private macro files; without them both warn on
# every import.
RUN python /opt/robosuite/robosuite/scripts/setup_macros.py && \
    python /opt/robocasa/robocasa/scripts/setup_macros.py

# Optional robosuite / RoboCasa dependencies, installed only to silence their
# "not installed" import warnings (see docker/RobocasaDockerfile).
RUN git clone https://github.com/ARISE-Initiative/robosuite_models /opt/robosuite_models && \
    git -C /opt/robosuite_models checkout --quiet 2d63a6b4319bda772420daf10594ce0de5bd793d && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-04.txt --system --no-cache -e /opt/robosuite_models && \
    git clone https://github.com/NVlabs/mimicgen /opt/mimicgen && \
    git -C /opt/mimicgen checkout --quiet 72bd767c255545f462e7ccfb2731f2e5d4c1d9bb && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-04.txt --system --no-cache -e /opt/mimicgen && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-04.txt --system --no-cache --no-deps "mink==0.0.5"

# RoboCasa's kitchen assets (about 10 GB), baked in; `echo y` answers the
# download script's one prompt.
RUN echo y | python -m robocasa.scripts.download_kitchen_assets --type all
# Check the downloaded tree against the committed digest (locks/SOURCES.md).
RUN cd /opt/robocasa/robocasa/models && \
    find assets -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | \
    sha256sum --check --quiet /opt/golem-locks/robocasa-assets.digest

WORKDIR /home/code/golem_robocasa

# A shell; docker-compose.yml's command runs launch_robocasa.sh instead.
CMD ["/bin/bash"]

# The msgs_ws toolchain, so launch_robocasa.sh can build the message-only
# workspace (magpie_msgs, custom_ros_messages) at every container start.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions \
        ros-humble-ament-cmake \
        ros-humble-ament-cmake-auto \
        ros-humble-ament-cmake-python \
        ros-humble-rosidl-default-generators \
    && rm -rf /var/lib/apt/lists/*

# The mount point of core_ws/src/{magpie_msgs,custom_ros_messages}.
RUN mkdir -p /home/code/msgs_ws/src

# Livox-SDK2 at the commit every image uses (tests/docker/test_source_pins.py),
# so the images agree on the CustomMsg wire format. The Mac sims publish no
# lidar, but the sensor modules import livox_ros_driver2's CustomMsg.
RUN git clone https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 && \
    git -C /tmp/Livox-SDK2 checkout --quiet 08f523c930b2f0ba1e98a6afaa8d7476bf479908 && \
    cd /tmp/Livox-SDK2 && mkdir build && cd build && \
    cmake .. -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && make -j"$(nproc)" && make install && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

# livox_ros_driver2's C++ build dependencies (its package_ROS2.xml).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpcl-dev libapr1-dev \
        ros-humble-pcl-conversions ros-humble-pcl-ros \
        ros-humble-rclcpp-components ros-humble-rcl-interfaces \
        ros-humble-rosbag2 \
        ros-humble-sensor-msgs ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/*

# livox_ros_driver2 at /opt/livox_ws (copied, not mounted: its build.sh rewrites
# its own tree; see docker/RobocasaDockerfile). build.sh exits 0 even when its
# colcon build fails (CLAUDE.md §8), so the import check fails the image
# instead.
COPY core_ws/src/livox_ros_driver2 /opt/livox_ws/src/livox_ros_driver2
RUN bash -c "source /opt/ros/humble/setup.bash && \
             cd /opt/livox_ws/src/livox_ros_driver2 && \
             ./build.sh humble && \
             source /opt/livox_ws/install/setup.bash && \
             python3 -c 'from livox_ros_driver2.msg import CustomMsg'"

# MuJoCo 3.17.0 over RoboCasa's 3.3.1 and the patches robosuite and RoboCasa
# need for it, as on x86 (docker/patches/; each file says why).
COPY docker/patches/robosuite-mujoco-3.17.0.patch docker/patches/robocasa-mujoco-3.17.0.patch /opt/golem-patches/
RUN uv pip install -c /opt/golem-locks/robocasa-arm64-05.txt --system --no-cache "mujoco==3.17.0" && \
    git -C /opt/robosuite apply /opt/golem-patches/robosuite-mujoco-3.17.0.patch && \
    git -C /opt/robocasa apply /opt/golem-patches/robocasa-mujoco-3.17.0.patch && \
    cd / && python -c "import mujoco, robosuite, robocasa; assert mujoco.__version__ == '3.17.0', mujoco.__version__"
