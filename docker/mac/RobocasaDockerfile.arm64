# golem_sim_robocasa:arm64: the Apple-Silicon (arm64, CPU-only) counterpart of
# docker/RobocasaDockerfile, on golem_base:arm64. It runs the H1-2 only. It
# renders with OSMesa (software) instead of EGL, uses FastDDS for its ROS side,
# and adds an optional VNC / noVNC display stack for the MuJoCo viewer. The
# simulator source is bind-mounted at runtime (docker/mac/docker-compose.yml);
# launch_robocasa_mac.sh starts it. The x86 file's comments give the reasons
# for the shared steps.
FROM golem_base:arm64
COPY docker/locks/robocasa-*.txt docker/locks/robocasa-assets.digest /opt/golem-locks/

# Optional build-time proxies (golem_base clears its own).
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

# There is no GPU or EGL path under Colima: render with OSMesa (software).
# launch_robocasa_mac.sh exports MUJOCO_GL for its display mode.
ENV MUJOCO_GL=osmesa

# MuJoCo's runtime rendering libraries: OSMesa, and EGL as in the x86 image
# (unused on the CPU).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libegl1-mesa libosmesa6 \
    && rm -rf /var/lib/apt/lists/*

# The MuJoCo Python bindings and Pillow. mujoco is 3.3.1, the version
# RoboCasa's setup.py pins.
RUN uv pip install -c /opt/golem-locks/robocasa-arm64-01.txt --system --no-cache \
        "mujoco==3.3.1" \
        "numpy>=2.2.6" \
        "Pillow>=10.0"

# robosuite and RoboCasa at fixed commits, from git, editable. RoboCasa's
# lerobot dependency pins torch 2.7.1.
RUN git clone https://github.com/ARISE-Initiative/robosuite /opt/robosuite && \
    git -C /opt/robosuite checkout --quiet 5ce6643f3092639d08f7b0f90ed1c6a84f50552c && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-02.txt --system --no-cache -e /opt/robosuite

RUN git clone https://github.com/robocasa/robocasa /opt/robocasa && \
    git -C /opt/robocasa checkout --quiet 4f8a2980def75a55dff96b990745b83540425f09 && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-03.txt --system --no-cache -e /opt/robocasa

# Write robosuite's and RoboCasa's private macro files; without them both warn
# on every import.
RUN python /opt/robosuite/robosuite/scripts/setup_macros.py && \
    python /opt/robocasa/robocasa/scripts/setup_macros.py

# Optional robosuite / RoboCasa dependencies, installed only to silence their
# "not installed" import warnings.
RUN git clone https://github.com/ARISE-Initiative/robosuite_models /opt/robosuite_models && \
    git -C /opt/robosuite_models checkout --quiet 2d63a6b4319bda772420daf10594ce0de5bd793d && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-04.txt --system --no-cache -e /opt/robosuite_models && \
    git clone https://github.com/NVlabs/mimicgen /opt/mimicgen && \
    git -C /opt/mimicgen checkout --quiet 72bd767c255545f462e7ccfb2731f2e5d4c1d9bb && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-04.txt --system --no-cache -e /opt/mimicgen && \
    uv pip install -c /opt/golem-locks/robocasa-arm64-04.txt --system --no-cache --no-deps "mink==0.0.5"

# RoboCasa's kitchen assets (about 10 GB), which every h12_mujoco.py task
# needs. `echo y` answers the download script's confirmation prompt.
RUN echo y | python -m robocasa.scripts.download_kitchen_assets --type all
# Check the downloaded tree against the committed digest (locks/SOURCES.md).
RUN cd /opt/robocasa/robocasa/models && \
    find assets -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | \
    sha256sum --check /opt/golem-locks/robocasa-assets.digest

WORKDIR /home/code/golem_robocasa

# A shell; the compose file's command runs launch_robocasa_mac.sh instead.
CMD ["/bin/bash"]

# -----------------------------------------------------------------------------
# The msgs_ws toolchain: colcon, ament and rosidl, so launch_robocasa_mac.sh
# can build the message-only workspace at every container start.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions \
        ros-humble-ament-cmake \
        ros-humble-ament-cmake-auto \
        ros-humble-ament-cmake-python \
        ros-humble-rosidl-default-generators \
    && rm -rf /var/lib/apt/lists/*

# The mount point of core_ws/src/{magpie_msgs,custom_ros_messages}.
RUN mkdir -p /home/code/msgs_ws/src

# -----------------------------------------------------------------------------
# Livox-SDK2, which livox_ros_driver2 links, at the commit every image uses
# (tests/docker/test_source_pins.py).
# -----------------------------------------------------------------------------
RUN git clone https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 && \
    git -C /tmp/Livox-SDK2 checkout --quiet 08f523c930b2f0ba1e98a6afaa8d7476bf479908 && \
    cd /tmp/Livox-SDK2 && mkdir build && cd build && \
    cmake .. -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && make -j"$(nproc)" && make install && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

# -----------------------------------------------------------------------------
# livox_ros_driver2's C++ build dependencies (its package_ROS2.xml).
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpcl-dev libapr1-dev \
        ros-humble-pcl-conversions ros-humble-pcl-ros \
        ros-humble-rclcpp-components ros-humble-rcl-interfaces \
        ros-humble-rosbag2 \
        ros-humble-sensor-msgs ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# livox_ros_driver2 at /opt/livox_ws, so h12_sensors.py can publish its
# CustomMsg on /livox/lidar. Copied, not bind-mounted, because build.sh
# rewrites its own source tree (RobocasaDockerfile has the details).
# -----------------------------------------------------------------------------
COPY core_ws/src/livox_ros_driver2 /opt/livox_ws/src/livox_ros_driver2
RUN bash -c "source /opt/ros/humble/setup.bash && \
             cd /opt/livox_ws/src/livox_ros_driver2 && \
             ./build.sh humble"

# -----------------------------------------------------------------------------
# FastDDS for the ROS (rclpy) side. h12_mujoco.py runs unitree_sdk2py's DDS
# (rt/lowstate, rt/lowcmd, through the PyPI `cyclonedds` binding and the
# source-built libddsc) and rclpy in one process. If rclpy also used
# rmw_cyclonedds_cpp, two CycloneDDS C libraries would load into that process,
# and on arm64 the second one to create DDS entities crashes or returns an
# invalid handle. docker/mac/docker-compose.yml sets
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp in both Mac containers, so they still
# talk to each other.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rmw-fastrtps-cpp \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# The optional VNC / noVNC display stack (GOLEM_DISPLAY=vnc,
# launch_robocasa_mac.sh). MuJoCo's GLFW window cannot be forwarded to macOS
# XQuartz: on Apple Silicon XQuartz's indirect GLX offers no usable fbConfigs
# ("No matching fbConfigs" / GLXBadContext). So the viewer renders in the
# container with llvmpipe into a virtual X display, and the pixels go out over
# VNC; this gives MuJoCo an OpenGL 4.5 context.
#   xvfb              virtual framebuffer X server
#   x11vnc            serves the Xvfb display over VNC
#   novnc, websockify browser VNC client and its WebSocket bridge
#   fluxbox           window manager, so the viewer window is framed
#   libgl1-mesa-dri   llvmpipe software OpenGL (swrast_dri.so)
#   x11-utils         xdpyinfo, for the Xvfb readiness check
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb x11vnc novnc websockify fluxbox \
        libgl1-mesa-dri x11-utils \
    && rm -rf /var/lib/apt/lists/*

# fluxbox's default style runs fbsetbg, which with no wallpaper setter
# installed pops up a "wallpaper cannot be set" message on the VNC display.
# This fbsetbg sets a solid background with fluxbox's own fbsetroot instead.
RUN printf '#!/bin/sh\nexec fbsetroot -solid "#2b2b2b"\n' > /usr/bin/fbsetbg \
    && chmod +x /usr/bin/fbsetbg
