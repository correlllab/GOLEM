# golem_ros:arm64: the Apple-Silicon (arm64, CPU-only) ROS 2 workspace image,
# on golem_base:arm64. A slim image, not a port of docker/RosDockerfile: it
# carries only what h12_sim_mac.launch.py starts (robot_state_publisher,
# joint_state_publisher, golem_upper_ik's frame_task_server, golem_safety's
# safety_node, the lower-body controller and golem_slam's navigation graph:
# FAST-LIO, OctoMap, slam_toolbox, Nav2), the packages and libraries those
# build against, and an optional RViz over VNC. It leaves out the vision and
# grasp ML stack, MJPC, rqt and the G1's packages. launch_ros_mac.sh builds the
# bind-mounted core_ws and starts the bringup.
FROM golem_base:arm64
COPY docker/locks/ros-*.txt /opt/golem-locks/

# Optional build-time proxies (golem_base clears its own).
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

# -----------------------------------------------------------------------------
# apt: colcon and the ament / rosidl build system, the message, TF, description
# and launch packages, and the C++ libraries the workspace links.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-numpy python3-scipy python3-yaml python3-transforms3d \
        libeigen3-dev libyaml-cpp-dev \
        ros-humble-ament-cmake \
        ros-humble-ament-cmake-auto \
        ros-humble-ament-cmake-python \
        ros-humble-rosidl-default-generators \
        ros-humble-action-msgs \
        ros-humble-builtin-interfaces \
        ros-humble-geometry-msgs \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
        ros-humble-std-srvs \
        ros-humble-xacro \
        ros-humble-robot-state-publisher \
        ros-humble-joint-state-publisher \
        ros-humble-launch-ros \
        ros-humble-launch-xml \
        ros-humble-tf2-ros \
        ros-humble-tf2-eigen \
        ros-humble-tf2-tools \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Python: golem_upper_ik's controller stack (Pink differential IK, the QP
# backends, OMPL planning, meshcat). OMPL ships a manylinux2014_aarch64 wheel,
# so nothing builds from source.
# -----------------------------------------------------------------------------
# Remove base's NumPy-2 pinocchio first; the next step's --ignore-installed
# writes over packages without uninstalling them.
RUN pip uninstall -y pin libpinocchio coal libcoal eigenpy
# numpy<2 binds the C extensions to the NumPy 1.x ABI of apt's scipy.
# --ignore-installed applies to the whole call; it lets pip replace apt's
# python3-blinker, which pip cannot uninstall.
RUN pip install -c /opt/golem-locks/ros-arm64-01.txt --no-cache-dir --ignore-installed blinker \
        "numpy<2" \
        "scikit-learn>=1.4" \
        pin-pink \
        qpsolvers \
        quadprog \
        proxsuite \
        "ompl==2.0.1" \
        pyquaternion \
        tqdm \
        meshcat \
        meshcat-shapes

# -----------------------------------------------------------------------------
# Clamp numpy, setuptools and wheel for colcon's ament_python builds and the
# scipy / pinocchio ABI: colcon's python_setup_py cannot read setup() arguments
# from setuptools 69+, wheel 0.44+ needs a newer setuptools, and numpy 2 breaks
# the ABI. The rm -rf clears the .dist-info directories that layered uv / pip
# upgrades leave behind, and the .pth line removes the newer setuptools'
# distutils-precedence.pth. RosDockerfile's step 6 has the details.
# -----------------------------------------------------------------------------
RUN rm -rf /usr/local/lib/python3.10/dist-packages/setuptools \
           /usr/local/lib/python3.10/dist-packages/setuptools-*.dist-info \
           /usr/local/lib/python3.10/dist-packages/pkg_resources \
           /usr/local/lib/python3.10/dist-packages/pkg_resources-*.dist-info \
           /usr/local/lib/python3.10/dist-packages/_distutils_hack \
           /usr/local/lib/python3.10/dist-packages/wheel \
           /usr/local/lib/python3.10/dist-packages/wheel-*.dist-info \
    && pip install -c /opt/golem-locks/ros-arm64-02.txt --no-cache-dir --no-deps "numpy<2" "setuptools==59.6.0" "wheel<0.44" \
    && rm -f /usr/local/lib/python3.10/dist-packages/distutils-precedence.pth

# FastDDS for ROS, as in RobocasaDockerfile.arm64 (which has the reason): a
# node that also opens a Unitree SDK (CycloneDDS) channel would load a second
# libddsc beside rmw_cyclonedds_cpp and crash on arm64.
# docker/mac/docker-compose.yml sets RMW_IMPLEMENTATION=rmw_fastrtps_cpp.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rmw-fastrtps-cpp \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# RViz and the VNC / noVNC display stack (GOLEM_RVIZ=vnc, launch_ros_mac.sh).
# Like the MuJoCo viewer, RViz's GL window cannot be forwarded to XQuartz on
# Apple Silicon (RobocasaDockerfile.arm64), so it renders with llvmpipe into
# its own Xvfb, served on VNC 5901 / noVNC 6081, apart from the MuJoCo
# viewer's 5900 / 6080.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rviz2 \
        xvfb x11vnc novnc websockify fluxbox \
        libgl1-mesa-dri x11-utils \
    && rm -rf /var/lib/apt/lists/*

# fluxbox's default style runs fbsetbg, which with no wallpaper setter pops up
# a "wallpaper cannot be set" message; this fbsetbg sets a solid background
# with fluxbox's fbsetroot instead.
RUN printf '#!/bin/sh\nexec fbsetroot -solid "#2b2b2b"\n' > /usr/bin/fbsetbg \
    && chmod +x /usr/bin/fbsetbg

# The DDS-IDL generator that unitree_hg (from unitree_ros2/cyclonedds_ws)
# find_package()s REQUIRED; h12_lowerbody_rl depends on unitree_hg. torch, the
# leg policies' runtime, comes from golem_base.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rosidl-generator-dds-idl \
    && rm -rf /var/lib/apt/lists/*

# golem_slam's navigation graph (GOLEM_SLAM=1 or GOLEM_NAV2=1): slam_toolbox
# builds the occupancy map from the scan pointcloud_to_laserscan flattens out
# of the self-filtered FAST-LIO cloud.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-slam-toolbox \
        ros-humble-pointcloud-to-laserscan \
    && rm -rf /var/lib/apt/lists/*

# Nav2 for the same graph: nav2-bringup pulls in the navigation2 metapackage,
# with the MPPI controller and the Smac planner golem_slam's nav2.yaml loads.
# Nav2 drives /cmd_vel, which the walking policy follows.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-nav2-bringup \
    && rm -rf /var/lib/apt/lists/*

# The rest of the graph: FAST-LIO (fast_lio, built from core_ws by
# launch_ros_mac.sh) needs PCL, pcl_ros / pcl_conversions and
# livox_ros_driver2 (below); octomap_server builds the 3D map and the costmaps'
# static layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpcl-dev libapr1-dev \
        ros-humble-pcl-conversions ros-humble-pcl-ros \
        ros-humble-rclcpp-components ros-humble-visualization-msgs \
        ros-humble-nav-msgs ros-humble-std-srvs \
        ros-humble-octomap-server \
    && rm -rf /var/lib/apt/lists/*

# Livox-SDK2, which livox_ros_driver2 links, at the commit every image builds
# (tests/docker/test_source_pins.py), so the images agree on the CustomMsg wire
# format.
RUN git clone https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 && \
    git -C /tmp/Livox-SDK2 checkout --quiet 08f523c930b2f0ba1e98a6afaa8d7476bf479908 && \
    cd /tmp/Livox-SDK2 && mkdir build && cd build && \
    cmake .. -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && make -j"$(nproc)" && make install && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

# livox_ros_driver2 at /opt/livox_ws, built by upstream's build.sh as the
# RoboCasa images build it (docker/BUILD.md §5): FAST-LIO reads its CustomMsg.
# Copied, not bind-mounted, because build.sh rewrites its own source tree.
# build.sh exits 0 even when its colcon build fails, so the CustomMsg import
# fails the image build instead. launch_ros_mac.sh sources /opt/livox_ws/install
# before it builds core_ws.
COPY core_ws/src/livox_ros_driver2 /opt/livox_ws/src/livox_ros_driver2
RUN bash -c "source /opt/ros/humble/setup.bash && \
             cd /opt/livox_ws/src/livox_ros_driver2 && \
             ./build.sh humble && \
             source /opt/livox_ws/install/setup.bash && \
             python3 -c 'from livox_ros_driver2.msg import CustomMsg'"

# Interactive shells source the workspace launch_ros_mac.sh builds, at
# /opt/core_ws/install (a named volume on the VM's own disk), not the
# bind-mounted /home/code/core_ws/install, which may hold a host-side build.
RUN echo '[ -f /opt/core_ws/install/setup.bash ] && source /opt/core_ws/install/setup.bash' >> /root/.bashrc

WORKDIR /home/code/core_ws

# Build the Mac's packages and start h12_sim_mac.launch.py (launch_ros_mac.sh).
CMD ["/home/code/h12_sim_scripts/launch_ros_mac.sh"]
